{
  "expo": {
    "name": "Memor QA",
    "slug": "memor-app",
    "scheme": "memorqa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.espindola.memor.app.qa",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O Memor usa a câmera para testar a criação e visualização de intervenções em realidade aumentada."
      }
    },
    "android": {
      "package": "com.espindola.memor.app.qa",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "O Memor usa a câmera para detectar superfícies e posicionar obras em realidade aumentada."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
